# Copy to .env.local. Supabase values: hosted project → Project Settings → API
# (or `npx supabase status` if running the local Docker stack).
# .env.local is git-ignored. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used to send volunteer invites. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Where invite and magic-link emails send people back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI for reading briefs: mock (free, offline) | gemini | groq. Check: npm run check:ai -- gemini groq
AI_PROVIDER=mock
# Used when the main provider hits its free-tier limit or is unreachable (e.g. groq or mock).
AI_FALLBACK=mock
# https://aistudio.google.com/apikey. Free tier: Google may use prompts to improve its models, so TEST DATA only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Launch (docs/launch.md). Everything below is optional: each feature stays off until its key is set. ---
# Cloudflare Turnstile bot check on sign-up/sign-in. The secret key goes in Supabase (Auth → Attack Protection), not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Sentry error tracking (public DSN). For readable stack traces also set SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT in Netlify.
NEXT_PUBLIC_SENTRY_DSN=
