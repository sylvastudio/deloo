{
  "expo": {
    "name": "Deloo",
    "slug": "deloo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deloo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "space.deloo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F6B73",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "space.deloo.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Deloo",
      "shortName": "Deloo",
      "themeColor": "#0F6B73",
      "backgroundColor": "#F3F5F4",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F6B73",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Deloo uses the camera to photograph equipment at handover, and for the ID photo and selfie that verify your account.",
          "photosPermission": "Deloo uses your photos to list your gear."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d27a8ec-46db-40d8-81b0-e9d254872259"
      }
    },
    "owner": "sylva-studio",
    "updates": {
      "url": "https://u.expo.dev/6d27a8ec-46db-40d8-81b0-e9d254872259"
    }
  }
}
